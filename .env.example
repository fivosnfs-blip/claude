# Trading 212 API credentials.
# Generate a key+secret pair in the app: Settings -> API (Beta) -> API keys.
# IMPORTANT: generate the key while your account is switched to the mode you
# intend to use it with. A key created under your demo/paper account will
# NOT authenticate against the live API, and vice versa.
T212_API_KEY=
T212_API_SECRET=

# false = paper trading (demo account), true = real money.
# Leave this false until you've completed several days of clean paper
# trading and have read through bot.log for anything that looks wrong.
T212_LIVE_MODE=false

# Extra, deliberate confirmation required before LIVE_MODE is allowed to run.
# The bot refuses to start in live mode unless this is exactly "yes".
I_UNDERSTAND_LIVE_RISK=
